# Copy to .env and fill in — that file is git-ignored, this template is not.
# Secrets are easiest to enter with: sh scripts/set-secrets.sh
ENVIRONMENT=prod
LOG_LEVEL=INFO

# Inside Docker these are overridden to /data by docker-compose.yml.
DATA_DIR=./var
BACKUP_DIR=./var/backups

# Your timezone (IANA name). Reports, "today" and the nightly plan run on this clock.
# Examples: Europe/Berlin, Europe/Warsaw, America/New_York.
DISPLAY_TIMEZONE=UTC

# The address the outside world reaches the service at, and therefore the OAuth
# issuer. No trailing slash. Needed only to connect claude.ai or a phone over HTTPS;
# leave empty to keep the service private (the OAuth endpoints then refuse to issue).
PUBLIC_BASE_URL=

# --- the assistant and Telegram ------------------------------------------------
# Anthropic API key: the Telegram bot's brain. Reports and the nightly training plan
# do NOT use it — they are plain code and work without a key.
ANTHROPIC_API_KEY=
# From the BotFather bot in Telegram.
TELEGRAM_BOT_TOKEN=
# Your own chat id (a number). Every other chat is ignored. Send any message to the
# userinfobot bot in Telegram to learn it.
TELEGRAM_OWNER_CHAT_ID=

# --- Garmin ----------------------------------------------------------------------
# Directory holding Garmin tokens. Empty means DATA_DIR/garmin-tokens, which is what
# `python -m app.cli garmin-login` writes to.
GARMIN_TOKEN_DIR=
# Write next week's training into the watch without the Telegram summary. Keep it
# false until you have watched the plans for a few weeks.
GYM_PLAN_SILENT=false
# Optional: your own FTP / threshold test workouts, kept on the calendar every six
# weeks. Format: <Garmin workout id>|<label>|<weekday 0=Mon..6=Sun>, separated by ";".
# The workout id is the number in the URL of the workout in Garmin Connect.
#   GARMIN_THRESHOLD_TESTS=1234567890|RAMP TEST — FTP|0;1234567891|LTHR TEST|2
GARMIN_THRESHOLD_TESTS=

# --- body ------------------------------------------------------------------------
# Height in cm, for body fat (US Navy method) and waist-to-height. Empty: not computed.
BODY_HEIGHT_CM=

# --- backups and alerts ----------------------------------------------------------
# Alerts deliberately do NOT go through Telegram: if the bot breaks, you must hear
# about it some other way. Any webhook that accepts {"text": "..."} (Slack, ntfy, …).
ALERT_WEBHOOK_URL=

# Off-box copy: any command you like, {path} is the backup file.
# Examples:
#   BACKUP_OFFSITE_COMMAND=scp {path} user@backup-host:/backups/regimen/
#   BACKUP_OFFSITE_COMMAND=rclone copy {path} remote:regimen-backups
# rclone reads DATA_DIR/rclone.conf (mode 600).
BACKUP_OFFSITE_COMMAND=

# --- network ---------------------------------------------------------------------
# Port the application is published on. Check it is free first.
APP_PORT=8090

# Caddy ports. Only needed with the "tls" profile (a domain, or <ip>.nip.io).
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8443

# Site name for Caddy. Empty means plain HTTP on CADDY_HTTP_PORT.
# A domain or <ip>.nip.io makes Caddy fetch a certificate and serve HTTPS.
PUBLIC_HOSTNAME=
